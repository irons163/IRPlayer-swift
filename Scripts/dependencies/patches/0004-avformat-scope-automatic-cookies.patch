 }
 
-static int parse_cookie(HTTPContext *s, const char *p, AVDictionary **cookies)
+static int parse_cookie(const char *p, AVDictionary **cookies,
+                        const char *source_url)
 {
     AVDictionary *new_params = NULL;
-    AVDictionaryEntry *e, *cookie_entry;
-    char *eql, *name;
+    AVDictionaryEntry *e, *cookie_entry, *domain_entry, *path_entry;
+    HTTPOrigin source_origin;
+    char *default_path = NULL, *encoded_path = NULL;
+    char *eql, *name, *stored_cookie = NULL;
+    int ret;
 
     // ensure the cookie is parsable
     if (parse_set_cookie(p, &new_params))
@@ -1244,16 +1358,71 @@ static int parse_cookie(HTTPContext *s, const char *p, AVDictionary **cookies)
             }
         }
     }
+
+    if (source_url) {
+        if (av_dict_get(new_params, COOKIE_HOST_ONLY_ATTR, NULL, 0) ||
+            av_dict_get(new_params, COOKIE_DEFAULT_PATH_ATTR, NULL, 0)) {
+            av_dict_free(&new_params);
+            return 0;
+        }
+        ret = http_parse_origin(source_url, &source_origin);
+        if (ret < 0) {
+            av_dict_free(&new_params);
+            return ret;
+        }
+        domain_entry = av_dict_get(new_params, "domain", NULL, 0);
+        if (domain_entry && domain_entry->value) {
+            if (!cookie_domain_matches(source_origin.host,
+                                       domain_entry->value)) {
+                av_dict_free(&new_params);
+                return 0;
+            }
+        }
+        path_entry = av_dict_get(new_params, "path", NULL, 0);
+        if (!path_entry || !path_entry->value || path_entry->value[0] != '/') {
+            default_path = cookie_default_path(source_url);
+            if (!default_path) {
+                av_dict_free(&new_params);
+                return AVERROR(ENOMEM);
+            }
+            encoded_path = cookie_encode_metadata(default_path);
+            av_free(default_path);
+            if (!encoded_path) {
+                av_dict_free(&new_params);
+                return AVERROR(ENOMEM);
+            }
+        }
+        stored_cookie = av_asprintf("%s%s%s%s%s", p,
+                                    encoded_path ? "; " COOKIE_DEFAULT_PATH_ATTR "=" : "",
+                                    encoded_path ? encoded_path : "",
+                                    domain_entry ? "" : "; " COOKIE_HOST_ONLY_ATTR "=",
+                                    domain_entry ? "" : source_origin.host);
+        av_free(encoded_path);
+        if (!stored_cookie) {
+            av_dict_free(&new_params);
+            return AVERROR(ENOMEM);
+        }
+    }
     av_dict_free(&new_params);
 
+    if (!stored_cookie && !(stored_cookie = av_strdup(p)))
+        return AVERROR(ENOMEM);
+
     // duplicate the cookie name (dict will dupe the value)
-    if (!(eql = strchr(p, '='))) return AVERROR(EINVAL);
-    if (!(name = av_strndup(p, eql - p))) return AVERROR(ENOMEM);
+    if (!(eql = strchr(stored_cookie, '='))) {
+        av_free(stored_cookie);
+        return AVERROR(EINVAL);
+    }
+    if (!(name = av_strndup(stored_cookie, eql - stored_cookie))) {
+        av_free(stored_cookie);
+        return AVERROR(ENOMEM);
+    }
 
     // add the cookie to the dictionary
-    av_dict_set(cookies, name, eql, AV_DICT_DONT_STRDUP_KEY);
+    ret = av_dict_set(cookies, name, eql, AV_DICT_DONT_STRDUP_KEY);
+    av_free(stored_cookie);
 
-    return 0;
+    return ret;
 }
 
 static int cookie_string(AVDictionary *dict, char **cookies)
@@ -1448,7 +1617,7 @@ static int process_line(URLContext *h, char *line, int line_count)
             av_free(s->mime_type);
             s->mime_type = av_get_token((const char **)&p, ";");
         } else if (!av_strcasecmp(tag, "Set-Cookie")) {
-            if (parse_cookie(s, p, &s->cookie_dict))
