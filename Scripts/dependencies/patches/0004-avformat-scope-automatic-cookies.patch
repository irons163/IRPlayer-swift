         } else if (!av_strcasecmp(tag, "Icy-MetaInt")) {
             s->icy_metaint = strtoull(p, NULL, 10);
@@ -1475,14 +1644,14 @@ static int process_line(URLContext *h, char *line, int line_count)
  *
  * @return a negative value if an error condition occurred, 0 otherwise
  */
-static int get_cookies(HTTPContext *s, char **cookies, const char *path,
-                       const char *domain)
+static int get_cookies(HTTPContext *s, char **cookies, const char *path)
 {
     // cookie strings will look like Set-Cookie header field values.  Multiple
     // Set-Cookie fields will result in multiple values delimited by a newline
     int ret = 0;
     char *cookie, *set_cookies, *next;
     char *saveptr = NULL;
+    HTTPOrigin request_origin;
 
     // destroy any cookies in the dictionary.
     av_dict_free(&s->cookie_dict);
@@ -1490,6 +1659,10 @@ static int get_cookies(HTTPContext *s, char **cookies, const char *path,
     if (!s->cookies)
         return 0;
 
+    ret = http_parse_origin(s->location, &request_origin);
+    if (ret < 0)
+        return ret;
+
     next = set_cookies = av_strdup(s->cookies);
     if (!next)
         return AVERROR(ENOMEM);
@@ -1498,10 +1671,11 @@ static int get_cookies(HTTPContext *s, char **cookies, const char *path,
     while ((cookie = av_strtok(next, "\n", &saveptr)) && !ret) {
         AVDictionary *cookie_params = NULL;
         AVDictionaryEntry *cookie_entry, *e;
+        char *default_path = NULL;
 
         next = NULL;
         // store the cookie in a dict in case it is updated in the response
-        if (parse_cookie(s, cookie, &s->cookie_dict))
+        if (parse_cookie(cookie, &s->cookie_dict, NULL))
             av_log(s, AV_LOG_WARNING, "Unable to parse '%s'\n", cookie);
 
         // continue on to the next cookie if this one cannot be parsed
@@ -1522,22 +1696,35 @@ static int get_cookies(HTTPContext *s, char **cookies, const char *path,
             }
         }
 
-        // if no domain in the cookie assume it appied to this request
-        if ((e = av_dict_get(cookie_params, "domain", NULL, 0)) && e->value) {
-            // find the offset comparison is on the min domain (b.com, not a.b.com)
-            int domain_offset = strlen(domain) - strlen(e->value);
-            if (domain_offset < 0)
-                goto skip_cookie;
+        if (av_dict_get(cookie_params, "secure", NULL, 0) &&
+            !request_origin.is_https)
+            goto skip_cookie;
 
-            // match the cookie domain
-            if (av_strcasecmp(&domain[domain_offset], e->value))
+        e = av_dict_get(cookie_params, COOKIE_HOST_ONLY_ATTR, NULL, 0);
+        if (e && e->value) {
+            if (av_strcasecmp(request_origin.host, e->value))
                 goto skip_cookie;
+        } else if ((e = av_dict_get(cookie_params, "domain", NULL, 0)) &&
+                   e->value &&
+                   !cookie_domain_matches(request_origin.host, e->value)) {
+            goto skip_cookie;
         }
 
-        // if a cookie path is provided, ensure the request path is within that path
-        e = av_dict_get(cookie_params, "path", NULL, 0);
-        if (e && av_strncasecmp(path, e->value, strlen(e->value)))
+        // Prefer the trusted default-path metadata added at receipt. An
+        // invalid Path attribute remains in the serialized cookie, but must
+        // not override the derived default when the jar is reparsed.
+        e = av_dict_get(cookie_params, COOKIE_DEFAULT_PATH_ATTR, NULL, 0);
+        if (e && e->value) {
+            if (cookie_decode_metadata(e->value, &default_path) < 0 ||
+                !cookie_path_matches(path, default_path)) {
+                av_free(default_path);
+                goto skip_cookie;
+            }
+            av_free(default_path);
+        } else if ((e = av_dict_get(cookie_params, "path", NULL, 0)) &&
+                   e->value && !cookie_path_matches(path, e->value)) {
             goto skip_cookie;
+        }
 
         // cookie parameters match, so copy the value
         if (!*cookies) {
@@ -1732,7 +1919,7 @@ static int http_connect(URLContext *h, const char *path, const char *local_path,
         av_bprintf(&request, "Content-Type: %s\r\n", s->content_type);
     if (!has_header(headers, "\r\nCookie: ") && s->cookies) {
         char *cookies = NULL;
-        if (!get_cookies(s, &cookies, path, hoststr) && cookies) {
+        if (!get_cookies(s, &cookies, local_path) && cookies) {
             av_bprintf(&request, "Cookie: %s\r\n", cookies);
