index 07a2135..68ec134 100644
--- a/libavformat/http.c
+++ b/libavformat/http.c
@@ -57,6 +57,11 @@
 #define HTTP_MUTLI    2
 #define MAX_EXPIRY    19
 #define WHITESPACES " \n\t\r"
+/* Stored only on cookies learned from a response. Keeping the source host in
+ * the serialized jar preserves its scope when options are copied to nested
+ * HTTP contexts; caller-supplied cookie strings remain backward compatible. */
+#define COOKIE_HOST_ONLY_ATTR "__ffmpeg_host_only"
+#define COOKIE_DEFAULT_PATH_ATTR "__ffmpeg_default_path"
 typedef enum {
     LOWER_PROTO,
     READ_HEADERS,
@@ -310,6 +315,111 @@ int ff_http_origin_matches(const char *origin_url, const char *url)
     return !av_strcasecmp(origin.host, target.host);
 }
 
+static int cookie_domain_matches(const char *hostname, const char *domain)
+{
+    uint8_t address[16];
+    size_t hostname_len, domain_len;
+
+    if (!hostname || !domain)
+        return 0;
+    while (*domain == '.')
+        domain++;
+    hostname_len = strlen(hostname);
+    domain_len = strlen(domain);
+    if (!domain_len || domain_len > hostname_len)
+        return 0;
+    if (inet_pton(AF_INET, hostname, address) == 1 ||
+        inet_pton(AF_INET6, hostname, address) == 1)
+        return hostname_len == domain_len && !av_strcasecmp(hostname, domain);
+    if (av_strcasecmp(hostname + hostname_len - domain_len, domain))
+        return 0;
+    return hostname_len == domain_len ||
+           hostname[hostname_len - domain_len - 1] == '.';
+}
+
+static char *cookie_default_path(const char *url)
+{
+    URLComponents uc;
+    const char *last_slash;
+    size_t path_len;
+
+    if (ff_url_decompose(&uc, url, NULL) < 0)
+        return NULL;
+    path_len = uc.query - uc.path;
+    if (!path_len || uc.path[0] != '/')
+        return av_strdup("/");
+
+    last_slash = uc.path + path_len - 1;
+    while (last_slash > uc.path && *last_slash != '/')
+        last_slash--;
+    if (last_slash == uc.path)
+        return av_strdup("/");
+    return av_strndup(uc.path, last_slash - uc.path);
+}
+
+static char *cookie_encode_metadata(const char *value)
+{
+    static const char hex[] = "0123456789abcdef";
+    size_t len = strlen(value);
+    char *encoded = av_malloc(2 * len + 1);
+    size_t i;
+
+    if (!encoded)
+        return NULL;
+    for (i = 0; i < len; i++) {
+        encoded[2 * i]     = hex[(uint8_t)value[i] >> 4];
+        encoded[2 * i + 1] = hex[(uint8_t)value[i] & 0xf];
+    }
+    encoded[2 * len] = 0;
+    return encoded;
+}
+
+static int cookie_decode_metadata(const char *encoded, char **value)
+{
+    size_t len = strlen(encoded);
+    char *decoded;
+    size_t i;
+
+    if (len & 1)
+        return AVERROR_INVALIDDATA;
+    decoded = av_malloc(len / 2 + 1);
+    if (!decoded)
+        return AVERROR(ENOMEM);
+    for (i = 0; i < len; i += 2) {
+        int byte;
+        int high = av_toupper(encoded[i]);
+        int low  = av_toupper(encoded[i + 1]);
+
+        if (!av_isxdigit(high) || !av_isxdigit(low)) {
+            av_free(decoded);
+            return AVERROR_INVALIDDATA;
+        }
+        high = high >= 'A' && high <= 'F' ? high - 'A' + 10 : high - '0';
+        low  = low  >= 'A' && low  <= 'F' ? low  - 'A' + 10 : low  - '0';
+        byte = high << 4 | low;
+        if (!byte) {
+            av_free(decoded);
+            return AVERROR_INVALIDDATA;
+        }
+        decoded[i / 2] = byte;
+    }
+    decoded[len / 2] = 0;
+    *value = decoded;
+    return 0;
+}
+
+static int cookie_path_matches(const char *request_path, const char *cookie_path)
+{
+    size_t cookie_len = strlen(cookie_path);
+    size_t request_len = strcspn(request_path, "?#");
+
+    if (!cookie_len || cookie_path[0] != '/' || cookie_len > request_len ||
+        strncmp(request_path, cookie_path, cookie_len))
+        return 0;
+    return cookie_len == request_len || cookie_path[cookie_len - 1] == '/' ||
+           request_path[cookie_len] == '/';
+}
+
 static int http_validate_transport_policy(URLContext *h, const char *url)
 {
     HTTPContext *s = h->priv_data;
@@ -1183,7 +1293,7 @@ static int parse_set_cookie(const char *set_cookie, AVDictionary **dict)
         next_param = NULL;
         param += strspn(param, WHITESPACES);
         if ((name = av_strtok(param, "=", &value))) {
-            if (av_dict_set(dict, name, value, 0) < 0) {
+            if (av_dict_set(dict, name, value ? value : "", 0) < 0) {
                 av_free(cstr);
