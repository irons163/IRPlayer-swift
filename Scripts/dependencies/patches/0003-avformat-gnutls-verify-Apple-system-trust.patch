+#ifdef __APPLE__
+/* GnuTLS owns the handshake, preserving TLS 1.3 support. For the default
+ * client trust policy, Apple owns certificate-chain and hostname validation.
+ * No application bytes may be read or written before this succeeds. */
+static int tls_verify_apple_system_trust(URLContext *h)
+{
+    TLSContext *p = h->priv_data;
+    TLSShared *c = &p->tls_shared;
+    const gnutls_datum_t *peers;
+    unsigned int count, i;
+    CFMutableArrayRef certificates = NULL;
+    CFArrayRef policies = NULL;
+    CFStringRef hostname = NULL;
+    SecPolicyRef ssl_policy = NULL;
+    SecPolicyRef revocation_policy = NULL;
+    SecTrustRef trust = NULL;
+    int ret = AVERROR(EIO);
+
+    if (ff_check_interrupt(&h->interrupt_callback))
+        return AVERROR_EXIT;
+    if (!c->host || !c->host[0] ||
+        gnutls_certificate_type_get(p->session) != GNUTLS_CRT_X509)
+        goto end;
+    peers = gnutls_certificate_get_peers(p->session, &count);
+    if (!peers || !count)
+        goto end;
+
+    certificates = CFArrayCreateMutable(NULL, count, &kCFTypeArrayCallBacks);
+    hostname = CFStringCreateWithCString(NULL, c->host, kCFStringEncodingUTF8);
+    if (!certificates || !hostname) {
+        ret = AVERROR(ENOMEM);
+        goto end;
+    }
+    for (i = 0; i < count; i++) {
+        CFDataRef data;
+        SecCertificateRef certificate;
+
+        if (!peers[i].data || !peers[i].size)
+            goto end;
+        data = CFDataCreate(NULL, peers[i].data, peers[i].size);
+        if (!data) {
+            ret = AVERROR(ENOMEM);
+            goto end;
+        }
+        certificate = SecCertificateCreateWithData(NULL, data);
+        CFRelease(data);
+        if (!certificate)
+            goto end;
+        CFArrayAppendValue(certificates, certificate);
+        CFRelease(certificate);
+    }
+
+    ssl_policy = SecPolicyCreateSSL(true, hostname);
+    revocation_policy = SecPolicyCreateRevocation(
+        kSecRevocationUseAnyAvailableMethod |
+        kSecRevocationNetworkAccessDisabled);
+    if (!ssl_policy || !revocation_policy) {
+        ret = AVERROR(ENOMEM);
+        goto end;
+    }
+    {
+        const void *values[] = { ssl_policy, revocation_policy };
+        policies = CFArrayCreate(NULL, values, 2,
+                                 &kCFTypeArrayCallBacks);
+    }
+    if (!policies) {
+        ret = AVERROR(ENOMEM);
+        goto end;
+    }
+    if (SecTrustCreateWithCertificates(certificates, policies, &trust) != errSecSuccess)
+        goto end;
+    /* Keep trust evaluation independent of additional network requests that
+     * cannot be cancelled by FFmpeg's I/O interrupt callback. The revocation
+     * policy limits checks to cached replies, while this call also disables
+     * missing-intermediate fetching. Servers should supply their chain. */
+    if (SecTrustSetNetworkFetchAllowed(trust, false) != errSecSuccess)
+        goto end;
+    if (ff_check_interrupt(&h->interrupt_callback)) {
+        ret = AVERROR_EXIT;
+        goto end;
+    }
+    if (SecTrustEvaluateWithError(trust, NULL))
+        ret = 0;
+    if (ff_check_interrupt(&h->interrupt_callback))
+        ret = AVERROR_EXIT;
+
+end:
+    if (trust)
+        CFRelease(trust);
+    if (policies)
+        CFRelease(policies);
+    if (revocation_policy)
+        CFRelease(revocation_policy);
+    if (ssl_policy)
+        CFRelease(ssl_policy);
+    if (hostname)
+        CFRelease(hostname);
+    if (certificates)
+        CFRelease(certificates);
+    if (ret < 0 && ret != AVERROR_EXIT)
+        av_log(h, AV_LOG_ERROR, "Apple system certificate verification failed\n");
+    return ret;
+}
+#endif
+
+static int tls_should_verify_peer(const TLSShared *c)
+{
+    return c->verify && !c->listen;
+}
+
+static int tls_verify_gnutls_peer(URLContext *h)
+{
+    TLSContext *p = h->priv_data;
+    TLSShared *c = &p->tls_shared;
+    unsigned int status, cert_list_size;
+    gnutls_x509_crt_t cert = NULL;
+    const gnutls_datum_t *cert_list;
+    int ret;
+
+    if ((ret = gnutls_certificate_verify_peers2(p->session, &status)) < 0) {
+        av_log(h, AV_LOG_ERROR, "Unable to verify peer certificate: %s\n",
+               gnutls_strerror(ret));
+        return AVERROR(EIO);
+    }
+    if (status & GNUTLS_CERT_INVALID) {
+        av_log(h, AV_LOG_ERROR, "Peer certificate failed verification\n");
+        return AVERROR(EIO);
+    }
+    if (gnutls_certificate_type_get(p->session) != GNUTLS_CRT_X509) {
+        av_log(h, AV_LOG_ERROR, "Unsupported certificate type\n");
+        return AVERROR(EIO);
+    }
+    cert_list = gnutls_certificate_get_peers(p->session, &cert_list_size);
+    if (!cert_list || !cert_list_size) {
+        av_log(h, AV_LOG_ERROR, "Peer did not provide a certificate\n");
+        return AVERROR(EIO);
+    }
+    if ((ret = gnutls_x509_crt_init(&cert)) < 0) {
+        av_log(h, AV_LOG_ERROR, "Unable to initialize peer certificate: %s\n",
+               gnutls_strerror(ret));
+        return AVERROR(EIO);
+    }
+    if ((ret = gnutls_x509_crt_import(cert, &cert_list[0],
+                                      GNUTLS_X509_FMT_DER)) < 0) {
+        av_log(h, AV_LOG_ERROR, "Unable to import peer certificate: %s\n",
+               gnutls_strerror(ret));
+        gnutls_x509_crt_deinit(cert);
+        return AVERROR(EIO);
+    }
+    ret = gnutls_x509_crt_check_hostname(cert, c->host);
+    gnutls_x509_crt_deinit(cert);
+    if (!ret) {
+        av_log(h, AV_LOG_ERROR,
+               "The certificate's owner does not match hostname %s\n", c->host);
+        return AVERROR(EIO);
+    }
+    return 0;
+}
